generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Author {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  listings Listing[]
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  listings    CategoryListing[]
}

model CategoryListing {
  id         Int @id @default(autoincrement())
  listingId  Int
  categoryId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  listing     Listing   @relation(fields: [listingId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@unique([listingId, categoryId])
  @@index([categoryId], map: "CategoryListing_categoryId_fkey")
}

model Listing {
  id               Int     @id @default(autoincrement())
  slug             String  @unique
  name             String
  phone            String?
  views            Int     @default(0)
  state            String
  image            String
  gallery          Json
  description      String? @db.Text
  rating           Float?
  website          String?
  operatingHours   String? @db.Text
  tags             Json
  locationId       Int
  authorId         Int
  type_of_service  Json
  review_generated String? @db.Text
  similar_places   Json
  status           String  @default("draft")
  data_id          String? @db.VarChar(255)
  google_reviews   Json?
  organizationId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([authorId], map: "Listing_authorId_fkey")
  @@index([locationId], map: "Listing_locationId_fkey")

  Review          Review[]
  categoryListing CategoryListing[]
  serviceRequests ServiceRequest[]
  claims      Claim[]


  organization   Organization?   @relation(fields: [organizationId], references: [id])
  location        Location           @relation(fields: [locationId], references: [id])
  author          Author             @relation(fields: [authorId], references: [id])
}

model Listing_old {
  id               Int     @id @default(autoincrement())
  slug             String  @unique(map: "Listing_slug_key")
  name             String
  phone            String?
  views            Int     @default(0)
  state            String
  image            String
  gallery          Json
  description      String? @db.Text
  rating           Float?
  website          String?
  operatingHours   String? @db.Text
  tags             Json
  locationId       Int
  authorId         Int
  type_of_service  Json
  review_generated String? @db.Text
  similar_places   Json
  status           String  @default("draft")

  @@index([authorId], map: "Listing_authorId_fkey")
  @@index([locationId], map: "Listing_locationId_fkey")
}

model Location {
  id        Int     @id @default(autoincrement())
  latitude  Float
  longitude Float
  address   String?
  listings Listing[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}

model Review {
  id                Int      @id @default(autoincrement())
  text              String   @db.Text
  rating            Float
  reviewerName      String
  reviewerEmail     String
  relationship      String
  careType          String
  foodRating        Float?
  activitiesRating  Float?
  staffRating       Float?
  facilityRating    Float?
  valueRating       Float?
  approved          Boolean  @default(false)
  listingId         Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  responses         ReviewResponse[]

  listing           Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId], map: "Review_listingId_fkey")
}

model ServiceRequest {
  id                 Int       @id @default(autoincrement())
  fullName           String
  email              String
  zipCode            String
  phone              String?
  careNeeded         String?
  relationToResident String?
  moveInDate         DateTime?
  budget             String?
  listingId          Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing        Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId], map: "ServiceRequest_listingId_fkey")
}


model Claim {
  id          Int      @id @default(autoincrement())
  listingId   Int
  userId      Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing  @relation(fields: [listingId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}


model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  password       String?
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId Int?
  clerkId   String @unique
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  claims         Claim[]
  roles          UserRole[]
  reviewResponses ReviewResponse[]
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  listings  Listing[]
  users     User[]
  roles     UserRole[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserRole {
  id             Int            @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           String         // e.g., "admin", "manager"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

model ReviewResponse {
  id          Int      @id @default(autoincrement())
  reviewId    Int
  userId      Int
  response    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  review      Review   @relation(fields: [reviewId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}